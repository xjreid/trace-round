POSTGRES_DB=traceround
POSTGRES_USER=traceround
POSTGRES_PASSWORD=traceround-local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/traceround
SPRING_DATASOURCE_USERNAME=traceround
SPRING_DATASOURCE_PASSWORD=traceround-local
FRONTEND_URL=http://localhost:5173
CODE_EXECUTION_PROVIDER=jdoodle
CODE_RUNNER_BASE_URL=http://localhost:8090
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Managed Judge0. Change CODE_EXECUTION_PROVIDER to judge0 after filling these.
# Keep the real key only in .env or deployment secrets.
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_AUTH_MODE=rapidapi
JUDGE0_POLL_TIMEOUT_SECONDS=12
JUDGE0_CPU_TIME_LIMIT_SECONDS=5

# Managed JDoodle credentials.
# The client ID and secret belong only in .env or deployment secrets.
JDOODLE_API_URL=https://api.jdoodle.com/v1
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

# Judge0 uses 45. JDoodle automatically uses its separate 18-run limit.
CODE_EXECUTION_QUOTAS_ENABLED=true
CODE_EXECUTION_DAILY_SUBMISSIONS=45
JDOODLE_DAILY_SUBMISSIONS=18
CODE_EXECUTION_IP_SUBMISSIONS_PER_DAY=20
CODE_EXECUTION_ACCOUNT_SUBMISSIONS_PER_DAY=30
CODE_EXECUTION_IP_SUBMISSIONS_PER_MINUTE=5
CODE_EXECUTION_ACCOUNT_SUBMISSIONS_PER_MINUTE=10
CODE_EXECUTION_RESET_ZONE=UTC

# Add these after creating OAuth applications.
# Then list the configured providers, separated by commas. For example:
# SPRING_PROFILES_ACTIVE=oauth-google,oauth-github
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The mock provider works without a key.
TRACEROUND_AI_PROVIDER=mock
TRACEROUND_AI_API_KEY=
TRACEROUND_AI_MODEL=
TRACEROUND_AI_TIMEOUT_SECONDS=30

# AI abuse controls. Use a long random AI_QUOTA_HASH_SALT in production.
AI_QUOTAS_ENABLED=true
AI_DAILY_QUOTA_UNITS=1000
AI_MAX_MESSAGES_PER_QUESTION=6
AI_IP_INTERVIEWS_PER_HOUR=10
AI_ACCOUNT_INTERVIEWS_PER_HOUR=20
AI_IP_MESSAGES_PER_MINUTE=20
AI_ACCOUNT_MESSAGES_PER_MINUTE=30
AI_QUOTA_HASH_SALT=replace-with-a-long-random-production-value
