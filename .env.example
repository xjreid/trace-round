POSTGRES_DB=traceround
POSTGRES_USER=traceround
POSTGRES_PASSWORD=traceround-local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/traceround
SPRING_DATASOURCE_USERNAME=traceround
SPRING_DATASOURCE_PASSWORD=traceround-local
FRONTEND_URL=http://localhost:5173
CODE_RUNNER_BASE_URL=http://localhost:8090
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Add these after creating OAuth applications.
# Then list the configured providers, separated by commas. For example:
# SPRING_PROFILES_ACTIVE=oauth-google,oauth-github
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The mock provider works without a key.
TRACEROUND_AI_PROVIDER=mock
TRACEROUND_AI_API_KEY=
TRACEROUND_AI_MODEL=
TRACEROUND_AI_TIMEOUT_SECONDS=30

# AI abuse controls. Use a long random AI_QUOTA_HASH_SALT in production.
AI_QUOTAS_ENABLED=true
AI_DAILY_QUOTA_UNITS=1000
AI_MAX_MESSAGES_PER_QUESTION=6
AI_IP_INTERVIEWS_PER_HOUR=10
AI_ACCOUNT_INTERVIEWS_PER_HOUR=20
AI_IP_MESSAGES_PER_MINUTE=20
AI_ACCOUNT_MESSAGES_PER_MINUTE=30
AI_QUOTA_HASH_SALT=replace-with-a-long-random-production-value
